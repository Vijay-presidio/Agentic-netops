The session object prevents DNS resolution failures in the sandbox.

import requests, json, time

BASE_DOMAIN = "cranial-ninth-clerical.ngrok-free.dev"
session = requests.Session()
session.headers.update({"ngrok-skip-browser-warning": "true"})

def bridge(method, path, payload=None, retries=3):
    url = f"https://{BASE_DOMAIN}{path}"
    for attempt in range(retries):
        try:
            if method == "GET":
                r = session.get(url, timeout=15)
            else:
                r = session.post(url, json=payload, timeout=60)
            return r.json()
        except Exception as e:
            if attempt < retries - 1:
                time.sleep(3)
                continue
            return {"success": False, "error": str(e)}

ALWAYS add time.sleep(1) between consecutive calls to different devices.

